---
import Docs from '../../layouts/Docs.astro'
import CommandRef from '../../components/CommandRef.astro'
import { getCliCommands, getModels } from '../../lib/manifest.ts'

const commands = getCliCommands().sort((a, b) => a.full.localeCompare(b.full))
const models = getModels().slice().sort((a, b) => a.id.localeCompare(b.id))
const modelsByProvider = new Map<string, typeof models>()
for (const model of models) {
  const list = modelsByProvider.get(model.provider) ?? []
  list.push(model)
  modelsByProvider.set(model.provider, list)
}
const modelProviders = [...modelsByProvider.keys()].sort((a, b) => a.localeCompare(b))
const inferenceProviders = [...new Set(models.map((model) => model.inferenceProvider))].sort()
const pagePath = Astro.url.pathname.replace(/\/$/, '') || ''

// Top-level commands live under Core. A topic command such as `cast session`
// (from session/index.ts) stays with the subcommands that share its name.
function groupKey(command: (typeof commands)[number]): string {
  const name = command.full.replace(/^cast /, '')
  if (name.includes(' ')) return command.topic
  const hasSubcommands = commands.some((other) => other.full.startsWith(`${command.full} `))
  return hasSubcommands ? name : 'core'
}

const groups = new Map<string, typeof commands>()
for (const c of commands) {
  const topic = groupKey(c)
  const list = groups.get(topic) ?? []
  list.push(c)
  groups.set(topic, list)
}

const topicOrder = ['core', 'git', 'meta']
const sortedTopics = [...groups.keys()].sort((a, b) => {
  const ai = topicOrder.indexOf(a)
  const bi = topicOrder.indexOf(b)
  if (ai === -1 && bi === -1) return a.localeCompare(b)
  if (ai === -1) return 1
  if (bi === -1) return -1
  return ai - bi
})
---

<Docs title="CLI reference" description="Every cast command, auto-extracted from source.">
  <h1>CLI reference</h1>
  <p>
    Auto-generated from <code>typescript/cast-cli/src/commands/</code> on every build.
    If a command is missing or its description looks wrong, that file is the source of truth.
  </p>

  <h2 id="contents">Contents</h2>
  <ul>
    {sortedTopics.map((topic) => (
      <li>
        <strong>{topic === 'core' ? 'Core' : topic}</strong>
        <ul>
          {(groups.get(topic) ?? []).map((c) => (
            <li><a href={`${pagePath}#${c.full.replace(/^cast /, '').replace(/\s+/g, '-')}`}><code>{c.full}</code></a> — {c.description}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>

  <hr />

  {sortedTopics.map((topic) => (
    <>
      <h2 id={`topic-${topic}`}>{topic === 'core' ? 'Core commands' : `${topic} commands`}</h2>
      {(groups.get(topic) ?? []).map((c) => <CommandRef command={c} />)}
    </>
  ))}

  <h2 id="known-models">Known models</h2>
  <p>
    Curated ids are the <code>knownModels</code> arrays in
    <code>python/cast/providers/manifest.json</code>. The list below is that
    extract. Each row's <code>provider</code> is the vendor segment of the id.
    <code>inferenceProvider</code> is the manifest row that owns it
    {inferenceProviders.length > 0 && (
      <> ({inferenceProviders.map((key, index) => (
        <>
          {index > 0 && ', '}
          <code>{key}</code>
        </>
      ))})</>
    )}.
    Direct providers ship with an empty <code>knownModels</code> list and accept
    any <code>&lt;prefix&gt;/&lt;id&gt;</code>. Their <code>cast model</code> and
    <code>/model</code> pickers load a live catalog. See
    <a href="getting-started/inference-providers">Inference providers</a>.
  </p>
  <p>
    <code>cast update --model</code> asks <code>model_status</code> in
    <code>python/cast/providers/registry.py</code>. An OpenRouter id must be in
    this list. One leading <code>openrouter/</code> is removed before that check,
    so the shipped default <code>openrouter/minimax/minimax-m2.5</code> is valid.
    An unknown OpenRouter id is rejected and the error lists these ids.
    A provider with <code>acceptsAnyModel</code> accepts every id under its prefix.
    When OpenRouter is the active builder provider, <code>cast model --list --json</code>
    prints the same <code>id</code>, <code>provider</code>, and <code>family</code>
    fields from the copy in <code>typescript/cast-cli/src/lib/models.ts</code>.
  </p>
  <p>
    See the <a href={`${pagePath}#update`}><code>cast update</code></a> reference
    for the flag, and <a href="building-agents/builder-model">Changing the builder model</a>
    for <code>cast model</code> and <code>/model</code>.
  </p>
  {modelProviders.map((provider) => (
    <>
      <h3 id={`known-models-${provider}`}>{provider}</h3>
      <ul>
        {(modelsByProvider.get(provider) ?? []).map((model) => (
          <li>
            <code>{model.id}</code>
            {' '}<span style="color:var(--color-fg-muted)">family {model.family}</span>
          </li>
        ))}
      </ul>
    </>
  ))}
</Docs>
