---
import Docs from '../../layouts/Docs.astro'
import SlashRef from '../../components/SlashRef.astro'
import { getSlashCommands } from '../../lib/manifest.ts'

const commands = getSlashCommands()
const pagePath = Astro.url.pathname.replace(/\/$/, '') || ''
const byCategory = new Map<string, typeof commands>()
for (const c of commands) {
  const list = byCategory.get(c.category) ?? []
  list.push(c)
  byCategory.set(c.category, list)
}

const categoryOrder = ['chat', 'agent', 'session', 'git']
const sortedCategories = [...byCategory.keys()].sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b),
)
---

<Docs title="TUI slash commands" description="Every /command available in the Cast TUI.">
  <h1>TUI slash commands</h1>
  <p>
    Slash commands are typed into the chat input. They all work without arguments;
    when a parameter is needed, a modal prompts for it.
    Auto-generated from <code>typescript/cast-tui/src/commands/slash-registry.ts</code>.
  </p>
  <p>
    <code>/model</code> and <code>/provider</code> are dev-only. They change the
    builder on this machine and are hidden from <code>/help</code> in production
    and on-host.
    <a href="building-agents/builder-model"><code>/model</code></a> lists the active
    inference provider's models.
    <a href="getting-started/provider"><code>/provider</code></a> switches that
    provider. Deploy hosts are a different list:
    <a href="deployment/providers">deployment providers</a>.
    Prefixes and keys are on
    <a href="getting-started/inference-providers">Inference providers</a>.
  </p>

  <h2 id="contents">Contents</h2>
  <ul>
    {sortedCategories.map((cat) => (
      <li>
        <strong>{cat}</strong>
        <ul>
          {(byCategory.get(cat) ?? []).map((c) => (
            <li><a href={`${pagePath}#${c.name.replace(/[^a-z0-9]/gi, '-')}`}><code>/{c.name}</code></a> — {c.description}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>

  <hr />

  {sortedCategories.map((cat) => (
    <>
      <h2 id={`category-${cat}`}>{cat} commands</h2>
      {(byCategory.get(cat) ?? [])
        .sort((a, b) => a.name.localeCompare(b.name))
        .map((c) => <SlashRef command={c} />)}
    </>
  ))}
</Docs>
