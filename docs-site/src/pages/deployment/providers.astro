---
import Docs from '../../layouts/Docs.astro'
import ProviderCard from '../../components/ProviderCard.astro'
import { getProviders } from '../../lib/manifest.ts'

const providers = getProviders().sort((a, b) => a.name.localeCompare(b.name))
---

<Docs title="Deployment providers" description="Every host Cast can deploy to.">
  <h1>Deployment providers</h1>
  <p>
    Use <code>cast deploy &lt;agent&gt; --provider &lt;key&gt;</code> to deploy to a specific
    platform. If you omit <code>--provider</code>, Cast prompts interactively.
    Auto-generated from <code>providers.manifest.json</code> in
    <code>typescript/cast-cli/src/lib/deploy</code>.
  </p>
  <p>
    These keys are hosting providers. The model an agent calls is an
    <a href="getting-started/inference-providers">inference provider</a>,
    switched with <a href="getting-started/provider"><code>cast provider</code></a>
    or <code>/provider</code>. A DigitalOcean Droplet token is not a
    DigitalOcean inference key.
  </p>
  <p>
    Sprites needs the <code>sprite</code> CLI. Set <code>SPRITES_TOKEN</code> to a
    token created at <a href="https://sprites.dev/account">sprites.dev/account</a>
    in the <code>org-slug/org-id/token-id/token-value</code> format.
    <code>sprite login</code> is an alternative.
    <code>FLY_API_TOKEN</code> is not a Sprites token. Cast copies
    <code>SPRITES_TOKEN</code> to <code>SPRITE_TOKEN</code> for the sprite CLI.
  </p>

  <table>
    <thead>
      <tr><th>Provider</th><th>Description</th><th>On-host TUI</th></tr>
    </thead>
    <tbody>
      {providers.map((p) => (
        <tr>
          <td><a href={`#${p.key}`}>{p.name}</a> <code style="color:var(--color-fg-muted);">--provider {p.key}</code></td>
          <td>{p.description}</td>
          <td>
            {p.supportsWithTui
              ? <span class="badge pro">supported</span>
              : <span style="color:var(--color-fg-muted)">no</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <hr />

  {providers.map((p) => <ProviderCard provider={p} />)}
</Docs>
