---
/**
 * Sidebar — the global navigation.
 *
 * Sections are sourced from the content collection schema. Within each
 * section, pages can be grouped into titled sub-headings (e.g. Building
 * Agents → Development Workflow). Auto-generated pages (/cli/reference,
 * /tui/slash-commands, /deployment/providers) are appended to the
 * group they belong to.
 */
import { getCollection } from 'astro:content'
import VersionPicker from './VersionPicker.astro'

interface NavItem {
  title: string
  href: string
  isCurrent: boolean
  isGenerated?: boolean
}

interface NavGroup {
  id: string | null
  title: string | null
  items: NavItem[]
}

interface NavSection {
  id: string
  title: string
  groups: NavGroup[]
}

type SidebarGroupConfig = {
  id: string | null
  title: string | null
  generated?: { title: string; href: string }[]
}

type SidebarSectionConfig = {
  id: string
  title: string
  groups?: SidebarGroupConfig[]
}

const SECTIONS: SidebarSectionConfig[] = [
  { id: 'getting-started', title: 'Getting Started' },
  {
    id: 'building-agents',
    title: 'Building Agents',
    groups: [
      { id: null,                    title: null },
      { id: 'development-workflow',  title: 'Development Workflow', generated: [
        { title: 'Slash commands',    href: 'tui/slash-commands' },
        { title: 'Command reference', href: 'cli/reference' },
      ] },
      { id: 'versioning',            title: 'Versioning' },
      { id: 'deployment',            title: 'Deployment', generated: [
        { title: 'Providers',         href: 'deployment/providers' },
      ] },
    ],
  },
  { id: 'configuration', title: 'Configuration' },
]

// Build a base-aware path from a base-relative href like "cli/reference".
// Resulting URLs are what the browser sees after <base> rewrites them.
const BASE = import.meta.env.BASE_URL // "/" in dev, "/castagent/" on Pages
function fullPath(href: string): string {
  if (!href) return BASE === '/' ? '/' : BASE
  return BASE + href
}

// Current page path, with optional trailing slash. Astro.url.pathname is
// the URL the browser actually requested, so it already includes the base.
const currentPath = Astro.url.pathname
function isCurrent(href: string): boolean {
  const target = fullPath(href)
  return currentPath === target || currentPath === target + '/' || currentPath === target.replace(/\/$/, '')
}
const isOverview = isCurrent('overview')

const prose = await getCollection('prose')
const proseBySection = new Map<string, typeof prose>()
for (const entry of prose) {
  const list = proseBySection.get(entry.data.section) ?? []
  list.push(entry)
  proseBySection.set(entry.data.section, list)
}

const sections: NavSection[] = SECTIONS.map((s) => {
  const allInSection = (proseBySection.get(s.id) ?? []).slice().sort(
    (a, b) => a.data.order - b.data.order,
  )

  // If no groups are configured, the section is a single flat list.
  const groupConfigs: SidebarGroupConfig[] = s.groups ?? [{ id: null, title: null }]

  const groups: NavGroup[] = groupConfigs.map((gc) => {
    const items: NavItem[] = []
    if (gc.id === null) {
      // null group catches pages without a `group` field.
      for (const entry of allInSection.filter((e) => !e.data.group)) {
        items.push({
          title: entry.data.title,
          href: entry.id,
          isCurrent: isCurrent(entry.id),
        })
      }
    } else {
      for (const entry of allInSection.filter((e) => e.data.group === gc.id)) {
        items.push({
          title: entry.data.title,
          href: entry.id,
          isCurrent: isCurrent(entry.id),
        })
      }
    }
    for (const gen of gc.generated ?? []) {
      items.push({
        title: gen.title,
        href: gen.href,
        isCurrent: isCurrent(gen.href),
        isGenerated: true,
      })
    }
    return { id: gc.id, title: gc.title, items }
  })

  return { id: s.id, title: s.title, groups }
})
---

<aside class="sidebar">
  <div class="brand-row">
    <a href="" class="brand">
      <img src="logo.svg" alt="" width="22" height="22" />
      <span>Cast Agent</span>
    </a>
    <VersionPicker />
  </div>

  <nav>
    <ul style="list-style:none;padding:0;margin:0;">
      <li>
        <a href="overview" class={isOverview ? 'active' : ''}>Overview</a>
      </li>
      <li>
        <a href="search" class={isCurrent('search') ? 'active' : ''}>Search</a>
      </li>
      {sections.map((section) => (
        <li>
          <h5>{section.title}</h5>
          <ul>
            {section.groups.map((group) => (
              <>
                {group.title && (
                  <li class="sidebar-subhead">{group.title}</li>
                )}
                {group.items.map((item) => (
                  <li>
                    <a href={item.href} class={item.isCurrent ? 'active' : ''}>
                      {item.title}
                      {item.isGenerated && <span class="badge" style="margin-left:0.4em;font-size:0.65em;">auto</span>}
                    </a>
                  </li>
                ))}
              </>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <h5>Meta</h5>
    <ul>
      <li><a href="changelog" class={isCurrent('changelog') ? 'active' : ''}>Changelog</a></li>
      <li><a href="status"    class={isCurrent('status')    ? 'active' : ''}>Status</a></li>
    </ul>
  </nav>
</aside>
