---
/**
 * CommandRef — renders one CLI command from data/cli.json.
 * Shows: full synopsis, description, args, flags, examples, source link.
 */
import type { CliCommand, FlagSpec, ArgSpec } from '../lib/types.ts'

interface Props {
  command: CliCommand
}

const { command } = Astro.props

const hasArgs = command.args.length > 0
const hasFlags = command.flags.length > 0

function fmtFlag(f: FlagSpec): string {
  let s = f.char ? `-${f.char}, ` : ''
  s += f.name.length === 1 ? `-${f.name}` : `--${f.name}`
  if (f.type === 'string' || f.type === 'integer') {
    s += ` <${f.name.replace(/^no-/, '')}>`
  }
  return s
}

function fmtArg(a: ArgSpec): string {
  return a.required ? `<${a.name}>` : `[${a.name}]`
}

const synopsis = `cast ${command.full.replace(/^cast /, '')}${hasArgs ? ' ' + command.args.map(fmtArg).join(' ') : ''}${hasFlags ? ' [flags]' : ''}`
---

<section id={command.full.replace(/^cast /, '').replace(/\s+/g, '-')} class="command-ref">
  <h2>
    <code>{command.full}</code>
  </h2>
  <p style="color:var(--color-fg-muted);margin:0.25rem 0 0.5rem;">{command.description}</p>

  <div class="cmd-synopsis">
    {synopsis}
  </div>

  {hasArgs && (
    <>
      <h3>Arguments</h3>
      <table>
        <thead>
          <tr><th>Name</th><th>Description</th><th>Required</th></tr>
        </thead>
        <tbody>
          {command.args.map((a) => (
            <tr>
              <td><code>{a.name}</code></td>
              <td>{a.description ?? '—'}</td>
              <td>{a.required ? 'yes' : 'no'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {hasFlags && (
    <>
      <h3>Flags</h3>
      <table>
        <thead>
          <tr><th>Flag</th><th>Description</th><th>Type</th><th>Default</th></tr>
        </thead>
        <tbody>
          {command.flags.map((f) => (
            <tr>
              <td><code>{fmtFlag(f)}</code></td>
              <td>{f.description ?? '—'}</td>
              <td>
                {f.type}
                {f.options && f.options.length > 0 && (
                  <div style="color:var(--color-fg-muted);font-size:0.85em;margin-top:0.2em;">
                    options: {f.options.join(', ')}
                  </div>
                )}
              </td>
              <td>
                {f.default !== undefined
                  ? <code>{String(f.default)}</code>
                  : <span style="color:var(--color-fg-muted)">—</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {command.examples.length > 0 && (
    <>
      <h3>Examples</h3>
      {command.examples.map((ex) => (
        <pre><code>{ex}</code></pre>
      ))}
    </>
  )}

  <p style="color:var(--color-fg-muted);font-size:0.85rem;">
    Source: <a href={`https://github.com/scott/castagent/blob/master/${command.source}`}><code>{command.source}</code></a>
  </p>
</section>
