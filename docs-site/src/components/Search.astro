---
/**
 * Client-side search. Pagefind indexes dist/ after `astro build`.
 * The bundle and result links follow the site base (`/` or `/vX.Y.Z/`).
 */
interface Props {
  id?: string
  autofocus?: boolean
}

const { id = 'docs-search', autofocus = false } = Astro.props
// Absolute from the site origin, including the Astro base. Pagefind fetches
// this path directly, so a root-only `/pagefind/` would miss versioned snapshots.
const bundlePath = `${import.meta.env.BASE_URL}pagefind/`
const baseUrl = import.meta.env.BASE_URL
---

<!--
  One ignored wrapper so the UI script is not indexed. Stylesheet and script
  URLs are base-relative; `<base href>` resolves them for `/` and `/vX.Y.Z/`.
-->
<div
  id={id}
  class="docs-search"
  data-pagefind-ignore
  data-docs-search
  data-bundle-path={bundlePath}
  data-base-url={baseUrl}
  data-autofocus={autofocus ? 'true' : 'false'}
>
  <div class="docs-search-ui"></div>
  <link rel="stylesheet" href="pagefind/pagefind-ui.css" />
  <script is:inline src="pagefind/pagefind-ui.js"></script>
  <script is:inline>
  ;(function () {
    function mount(root) {
      if (root.dataset.mounted === 'true') return
      if (typeof PagefindUI !== 'function') return
      var uiRoot = root.querySelector('.docs-search-ui')
      if (!uiRoot) return
      root.dataset.mounted = 'true'
      var ui = new PagefindUI({
        element: uiRoot,
        bundlePath: root.dataset.bundlePath,
        baseUrl: root.dataset.baseUrl,
        showImages: false,
        showSubResults: true,
        autofocus: root.dataset.autofocus === 'true',
        focusOnSlash: false,
        translations: { placeholder: 'Search docs' },
      })
      var query = new URLSearchParams(window.location.search).get('q')
      if (!query) return
      var input = root.querySelector('input')
      if (input) {
        input.value = query
        input.dispatchEvent(new Event('input', { bubbles: true }))
      } else if (ui && typeof ui.triggerSearch === 'function') {
        ui.triggerSearch(query)
      }
    }

    function mountAll() {
      document.querySelectorAll('[data-docs-search]').forEach(mount)
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mountAll)
    } else {
      mountAll()
    }
  })()
</script>

<style is:inline>
  .docs-search {
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-fg);
    --pagefind-ui-background: var(--color-bg-elevated);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-accent-bg);
    --pagefind-ui-border-radius: var(--radius);
    --pagefind-ui-font: var(--font-sans);
  }

  .docs-topbar .docs-search { --pagefind-ui-scale: 0.72; }

  .docs-search .pagefind-ui--reset mark {
    background: var(--color-accent-bg);
    color: var(--color-fg);
  }

  .docs-topbar .pagefind-ui__drawer {
    position: absolute;
    z-index: 6;
    left: 0;
    right: 0;
    max-height: 70vh;
    overflow: auto;
    padding: 0.25rem 0.85rem 0.5rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
</style>
</div>
