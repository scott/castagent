{
  "name": "cast-cli",
  "version": "2.0.0",
  "description": "Cast - Agent Building & Deployment Platform CLI",
  "author": "Cast Team",
  "bin": {
    "cast": "./bin/run"
  },
  "homepage": "https://github.com/scott/castagent",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "repository": "scott/castagent",
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "^3",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "axios": "^1.6.8",
    "better-sqlite3": "^9.4.3",
    "keytar": "^7.9.0",
    "simple-git": "^3.36.0",
    "tar": "^7.5.16",
    "ws": "^8.16.0",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20",
    "@types/tar": "^6.1.13",
    "@types/ws": "^8.5.10",
    "oclif": "^4",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "oclif": {
    "bin": "cast",
    "dirname": "cast",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "meta": {
        "description": "Meta-builder test commands"
      },
      "git": {
        "description": "Git operations for agents"
      }
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint . --ext .ts",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"tests/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "oclif",
    "ai",
    "agents",
    "cli"
  ],
  "types": "dist/index.d.ts"
}
