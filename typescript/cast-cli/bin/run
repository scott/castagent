#!/usr/bin/env node

const {execute} = require('@oclif/core')

// If no arguments are provided, inject "new" as the default command
// This makes 'cast' (without arguments) open the TUI in "new" mode
const args = process.argv.slice(2)
if (args.length === 0) {
  process.argv.push('new')
}

execute({dir: __dirname})