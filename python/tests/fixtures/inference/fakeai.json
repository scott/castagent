{
  "key": "fakeai",
  "impl": "openai-compatible",
  "name": "FakeAI",
  "displayName": "Fake AI",
  "prefixes": ["fakeai/"],
  "default": false,
  "envVar": "FAKEAI_API_KEY",
  "configKey": "providers.fakeai.api_key",
  "baseUrl": "https://fakeai.example/v1",
  "baseUrlEnv": "FAKEAI_BASE_URL",
  "acceptsAnyModel": true,
  "knownModels": ["chat-small"],
  "modelsPath": "/models",
  "modelsFilter": "^chat-",
  "modelsHeaders": {"Authorization": "Bearer ${token}"},
  "fallbackModels": ["chat-small"],
  "defaultModel": "fakeai/chat-small",
  "llmDefaultModel": "chat-small",
  "defaultParams": {"temperature": 0.7},
  "omitTemperatureModels": ["^reason-"],
  "keyless": false,
  "settings": [{"env": "FAKEAI_REGION", "configKey": "providers.fakeai.region"}],
  "stripModelIdPrefix": "models/",
  "missingKeyMessage": "FAKEAI_API_KEY environment variable is required for Fake AI"
}
