      "global.anthropic.claude-sonnet-4-6",
      "global.anthropic.claude-haiku-5-5",
      "global.anthropic.claude-haiku-4-5-20251001-v1:0"
    ],
    "impl": "openai-compatible",
    "llmDefaultModel": "global.anthropic.claude-sonnet-4-6",
    "missingKeyMessage": "AWS_BEARER_TOKEN_BEDROCK environment variable is required for Amazon Bedrock. Create a key in the Amazon Bedrock console.",
    "defaultParams": {"temperature": 0.7},
    "settings": [
      {"env": "BEDROCK_REGION", "configKey": "providers.bedrock.region"}
    ],
    "enableNote": "Long-term Bedrock API keys are for exploration and work only in the Region where they were generated. Short-term keys expire within 12 hours and are Region-bound, so a deployed agent stops when that key expires. This version forwards the API key and region. It does not use IAM."
