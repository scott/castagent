[
  {
    "key": "openrouter",
    "name": "OpenRouter",
    "default": true,
    "prefixes": [
      "openrouter/"
    ],
    "envVar": "OPENROUTER_API_KEY",
    "configKey": "providers.openrouter.api_key",
    "baseUrl": "https://openrouter.ai/api/v1",
    "baseUrlEnv": "OPENROUTER_BASE_URL",
    "acceptsAnyModel": false,
    "displayName": "OpenRouter",
    "defaultModel": "openrouter/minimax/minimax-m2.5",
    "knownModels": [
      "anthropic/claude-opus-4.5",
      "anthropic/claude-sonnet-4.6",
      "openai/gpt-4o",
      "openai/gpt-4o-mini",
      "openai/gpt-4-turbo",
      "openai/gpt-4",
      "google/gemini-2.5-pro",
      "google/gemini-2.5-flash",
      "meta-llama/llama-4-scout",
      "meta-llama/llama-4-maverick",
      "meta-llama/llama-3.3-70b-instruct",
      "meta-llama/llama-3.1-70b-instruct",
      "meta-llama/llama-3.1-8b-instruct",
      "minimax/minimax-m2.5",
      "minimax/minimax-m2",
      "deepseek/deepseek-chat-v3-0324",
      "deepseek/deepseek-chat",
      "mistralai/mistral-large",
      "mistralai/mistral-nemo",
      "cohere/command-r-plus-08-2024",
      "cohere/command-r7b-12-2024"
    ]
  },
  {
    "key": "digitalocean",
    "name": "DigitalOcean",
    "default": false,
    "prefixes": [
      "digitalocean/"
    ],
    "envVar": "DIGITALOCEAN_MODEL_ACCESS_KEY",
    "configKey": "providers.digitalocean_inference.api_key",
    "baseUrl": "https://inference.do-ai.run/v1",
    "baseUrlEnv": "DIGITALOCEAN_INFERENCE_BASE_URL",
    "acceptsAnyModel": true,
    "displayName": "DigitalOcean Serverless Inference",
    "modelsPath": "/models",
    "fallbackModels": ["llama3.3-70b-instruct", "deepseek-v3.2"],
    "defaultModel": "digitalocean/llama3.3-70b-instruct",
    "knownModels": []
  }
]
