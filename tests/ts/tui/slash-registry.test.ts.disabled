/**
 * Tests for the cast-tui slash command registry.
 *
 * ## Why this file is shaped the way it is
 *
 * The cast-tui source is an ESM module that depends on @opentui/core,
 * which is a Bun-targeted package: it uses static `import "bun:ffi"`
 * and `import "*.scm" with { type: "file" }` statements that Node's
 * ESM loader cannot resolve. Loading the source directly from this
 * Mocha test (via `require()` or `await import()`) hits a
 * `ERR_UNSUPPORTED_ESM_URL_SCHEME` (for `bun:` URLs) or an
 * `ERR_UNKNOWN_FILE_EXTENSION` (for `.scm` files).
 *
 * To exercise the real module from a Node test environment, this file
 * spawns a Node subprocess with a custom ESM loader (see `_loader.mjs`)
 * that redirects the Bun-only dependencies to lightweight stubs in
 * `_stubs/`. The subprocess runs the actual test cases (`_runner.mjs`)
 * using Node's built-in test runner (`node --test`).
 *
 * The subprocess emits TAP. The Mocha tests in this file parse the
 * TAP and create a corresponding Mocha `it()` block for each
 * subprocess assertion, so the Mocha output shows the same level of
 * detail as a normal in-process test run.
 *
 * Note that the subprocess is invoked twice: once to discover the
 * list of test names (used to register Mocha `it()` blocks), and once
 * in `before()` to actually run them. The subprocess is fast (well
 * under a second) so this is an acceptable trade-off for keeping the
 * test names visible in `npx mocha` output.
 */
import {expect} from 'chai'
import {execFileSync} from 'child_process'
import * as path from 'path'

interface SubprocessResult {
  name: string
  status: 'pass' | 'fail'
  error: string | null
}

/**
 * Parse TAP-style output emitted by `node --test` and return one entry
 * per subtest.
 */
function parseTapOutput(output: string): SubprocessResult[] {
  const results: SubprocessResult[] = []
  const lines = output.split('\n')
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i]
    const okMatch = line.match(/^ok (\d+) - (.+)$/)
    const notOkMatch = line.match(/^not ok (\d+) - (.+)$/)
    if (okMatch) {
      results.push({name: okMatch[2].trim(), status: 'pass', error: null})
    } else if (notOkMatch) {
      let error = ''
      for (let j = i + 1; j < lines.length; j++) {
        if (lines[j].match(/^(ok|not ok|#) /)) break
        error += lines[j] + '\n'
      }
      results.push({name: notOkMatch[2].trim(), status: 'fail', error: error.trim()})
    }
  }
  return results
}

/**
 * Build the argv for the subprocess. The same arguments are used
 * whether the subprocess is being run for "discover names" or
 * "actually run the tests".
 */
function buildSubprocessCommand(): {command: string; args: string[]; projectRoot: string} {
  const runnerPath = path.join(__dirname, '_runner.mjs')
  const loaderAbs = path.join(__dirname, '_loader.mjs')
  const projectRoot = path.resolve(__dirname, '../..') + path.sep
  const loaderBootstrap = [
    'data:text/javascript,',
    'import { register } from "node:module";',
    'import { pathToFileURL } from "node:url";',
    `register(${JSON.stringify(loaderAbs)}, pathToFileURL(${JSON.stringify(projectRoot)}));`,
  ].join('')
  return {
    command: 'node',
    args: ['--import', loaderBootstrap, '--test', runnerPath],
    projectRoot,
  }
}

/**
 * Run the subprocess and return the parsed TAP results.
 */
function runSubprocess(): {results: SubprocessResult[]; error: Error | null} {
  const {command, args, projectRoot} = buildSubprocessCommand()
  let stdout = ''
  let error: Error | null = null
  try {
    stdout = execFileSync(command, args, {encoding: 'utf8', cwd: projectRoot})
  } catch (err: any) {
    error = err
    stdout = err.stdout || ''
  }
  return {results: parseTapOutput(stdout), error}
}

// --------------------------------------------------------------------------
// Discover the list of test names by running the subprocess once at
// file load time. The subprocess is fast and idempotent, so this is an
// acceptable way to register meaningful Mocha test names without
// waiting for `before()`.
// --------------------------------------------------------------------------

const discovered = runSubprocess()
const discoveredResults = discovered.results
const discoveredNames = discoveredResults.map((r) => r.name)

// Shared state populated by `before()`; read by each per-test `it()`.
let runResults: SubprocessResult[] = []
let runError: Error | null = null

describe('slash-registry', function () {
  this.timeout(60_000)

  before(() => {
    const {results, error} = runSubprocess()
    runResults = results
    runError = error
  })

  it('subprocess reported at least one test', () => {
    if (runResults.length === 0) {
      const reason = runError ? `: ${runError.message}` : ''
      throw new Error(`Subprocess produced no TAP results${reason}`)
    }
    expect(runResults.length).to.be.greaterThan(0)
  })

  // Register a per-result test for every name we discovered. This
  // block is a no-op when the discovery pass found nothing.
  for (const name of discoveredNames) {
    it(name, () => {
      const matching = runResults.find((r) => r.name === name)
      if (!matching) {
        // This name was discovered on the first run but is missing
        // from the second run; treat as a failure for visibility.
        throw new Error(`test '${name}' missing from second subprocess run`)
      }
      if (matching.status === 'fail') {
        throw new Error(matching.error || `subprocess test '${name}' failed`)
      }
    })
  }
})
