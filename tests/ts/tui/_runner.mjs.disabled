/**
 * Test runner for the cast-tui slash-registry module.
 *
 * This file is executed in a child Node process with a custom ESM
 * loader (see `_loader.mjs`) that stubs out the Bun-only dependencies
 * of the cast-tui source. It runs the real test cases and emits TAP
 * output for the parent Mocha test to parse.
 *
 * ## Test environment
 *
 * The runner sets up several shared stubs before importing the
 * cast-tui module:
 *
 *  - `__testConfig.db` — configuration for the db stub. Tests can
 *    populate this to set active deployments, releases, etc.
 *  - `__testConfig.modals` — array of every modal created during
 *    the test run. Tests inspect this to assert on modal titles,
 *    content, etc.
 *  - `__testConfig.deployCalls` — array of calls made to
 *    `runDeployInTerminal`. Tests inspect this to assert that
 *    /deploy skipped the modal flow.
 *  - `__testConfig.execFileSyncCalls` — array of every call to
 *    `child_process.execFileSync` (or `execSync` / `spawn`).
 *    Tests inspect this to assert on the binary + args.
 *
 * Every test should call `__resetTestState()` in its setup to clear
 * the global stubs.
 */

import { test } from 'node:test'
import { expect } from 'chai'
import * as sinon from 'sinon'
import * as fs from 'fs'
import * as os from 'os'
import * as path from 'path'

// --------------------------------------------------------------------------
// Test environment setup
// --------------------------------------------------------------------------

if (!globalThis.__testConfig) globalThis.__testConfig = {}
if (!globalThis.__testConfig.modals) globalThis.__testConfig.modals = []
if (!globalThis.__testConfig.deployCalls) globalThis.__testConfig.deployCalls = []
if (!globalThis.__testConfig.execFileSyncCalls) globalThis.__testConfig.execFileSyncCalls = []
globalThis.__testConfig.db = {}

// Reset every test-level stub between tests.
function __resetTestState() {
  globalThis.__testConfig.modals = []
  globalThis.__testConfig.deployCalls = []
  globalThis.__testConfig.execFileSyncCalls = []
  globalThis.__testConfig.db = {}
}

// --------------------------------------------------------------------------
// 1. Import the cast-tui module
// --------------------------------------------------------------------------

const reg = await import(
  '/Users/scott/Workspace/agent-cast/typescript/cast-tui/dist/commands/slash-registry.js'
)

// --------------------------------------------------------------------------
// 2. Export validation
// --------------------------------------------------------------------------

test('exports slashCommands as an array', () => {
  expect(reg.slashCommands).to.be.an('array')
  expect(reg.slashCommands.length).to.be.greaterThan(0)
})

test('exports executeSlashCommand as a function', () => {
  expect(reg.executeSlashCommand).to.be.a('function')
})

test('exports getCommandSuggestions as a function', () => {
  expect(reg.getCommandSuggestions).to.be.a('function')
})

test('every command has the required fields', () => {
  for (const cmd of reg.slashCommands) {
    expect(cmd.name, `command name: ${cmd.name}`).to.be.a('string')
    expect(cmd.name.length, `command name: ${cmd.name}`).to.be.greaterThan(0)
    expect(cmd.description, `command ${cmd.name} description`).to.be.a('string')
    expect(['chat', 'agent', 'session', 'git'], `command ${cmd.name} category`).to.include(cmd.category)
    expect(cmd.handler, `command ${cmd.name} handler`).to.be.a('function')
  }
})

test('includes the 9 PRD commands', () => {
  const names = reg.slashCommands.map((c) => c.name)
  for (const expected of [
    'changes', 'versions', 'release', 'deploy', 'upgrade',
    'restore', 'diff', 'registry', 'connect',
  ]) {
    expect(names, `should include /${expected}`).to.include(expected)
  }
})

test('PRD command categories match the spec', () => {
  const byName = Object.fromEntries(reg.slashCommands.map((c) => [c.name, c]))
  expect(byName.changes.category).to.equal('session')
  expect(byName.versions.category).to.equal('session')
  expect(byName.release.category).to.equal('agent')
  expect(byName.deploy.category).to.equal('agent')
  expect(byName.upgrade.category).to.equal('agent')
  expect(byName.restore.category).to.equal('agent')
  expect(byName.diff.category).to.equal('agent')
  expect(byName.registry.category).to.equal('session')
  expect(byName.connect.category).to.equal('session')
})

test('args-bearing PRD commands advertise their args', () => {
  const byName = Object.fromEntries(reg.slashCommands.map((c) => [c.name, c]))
  expect(byName.release.args, '/release should have args').to.be.a('string')
  expect(byName.deploy.args, '/deploy should have args').to.be.a('string')
  expect(byName.restore.args, '/restore should have args').to.be.a('string')
  expect(byName.diff.args, '/diff should have args').to.be.a('string')
  expect(byName.connect.args, '/connect should have args').to.be.a('string')
})

test('non-args PRD commands do not advertise args', () => {
  const byName = Object.fromEntries(reg.slashCommands.map((c) => [c.name, c]))
  // /upgrade, /changes, /versions, /registry do not take args per the PRD.
  expect(byName.upgrade.args, '/upgrade should not have args').to.not.exist
  expect(byName.changes.args, '/changes should not have args').to.not.exist
  expect(byName.versions.args, '/versions should not have args').to.not.exist
  expect(byName.registry.args, '/registry should not have args').to.not.exist
})

// --------------------------------------------------------------------------
// 3. getCommandSuggestions
// --------------------------------------------------------------------------

test('getCommandSuggestions filters by prefix', () => {
  const sugg = reg.getCommandSuggestions('cha')
  const names = sugg.map((c) => c.name)
  expect(names).to.include('changes')
})

test('getCommandSuggestions is case-insensitive', () => {
  const lower = reg.getCommandSuggestions('cha')
  const upper = reg.getCommandSuggestions('CHA')
  expect(lower.map((c) => c.name).sort()).to.deep.equal(upper.map((c) => c.name).sort())
})

test('getCommandSuggestions returns empty array for unknown prefix', () => {
  expect(reg.getCommandSuggestions('xyzzy')).to.have.length(0)
})

test('getCommandSuggestions with empty prefix returns all commands', () => {
  const all = reg.getCommandSuggestions('')
  expect(all).to.have.length(reg.slashCommands.length)
})

// --------------------------------------------------------------------------
// 4. executeSlashCommand dispatcher
// --------------------------------------------------------------------------

function makeBaseCtx(overrides = {}) {
  const messages = []
  const ctx = {
    agentName: 'tui-slash-test',
    agentUrl: 'http://localhost:9999',
    authToken: undefined,
    mode: 'build',
    renderer: { root: { add: () => {} }, render: () => {}, destroy: () => {}, isDestroyed: false },
    client: {},
    messages: {
      addAgentMessage: (text, mode) => { messages.push({text, mode}) },
      scrollBox: { getChildren: () => [], remove: () => {} },
    },
    input: { focus: () => {} },
    setMode: () => {},
    reinitializeChat: async () => {},
    exitTui: () => {},
    messageHistory: [],
    lastAgentMessage: undefined,
    ...overrides,
  }
  return {ctx, messages}
}

test('executeSlashCommand returns false for unknown command', async () => {
  __resetTestState()
  const {ctx} = makeBaseCtx()
  const result = await reg.executeSlashCommand('xyzzy-not-real', [], ctx)
  expect(result).to.equal(false)
})

test('executeSlashCommand returns true for known command', async () => {
  __resetTestState()
  const {ctx} = makeBaseCtx()
  // /reset is a non-modal command that just resets message state.
  const result = await reg.executeSlashCommand('reset', [], ctx)
  expect(result).to.equal(true)
})

test('executeSlashCommand catches and reports handler errors', async () => {
  __resetTestState()
  const {ctx, messages} = makeBaseCtx()
  // Provide a renderer that throws to simulate a handler crash.
  ctx.renderer = {
    root: { add: () => { throw new Error('boom') } },
    render: () => {},
    destroy: () => {},
    isDestroyed: false,
  }
  const result = await reg.executeSlashCommand('list', [], ctx)
  // The dispatcher should still report success and surface the error to the chat.
  expect(result).to.equal(true)
  const found = messages.find((m) => m.text && m.text.includes('boom'))
  expect(found, 'an error message containing the handler error should be added').to.exist
})

// --------------------------------------------------------------------------
// 5. /upgrade handler
// --------------------------------------------------------------------------

test('/upgrade reports "not currently deployed" when no deployment exists', async () => {
  __resetTestState()
  // Configure db to return no active deployment.
  globalThis.__testConfig.db.state = {activeDeploymentByAgent: {}}

  const {ctx, messages} = makeBaseCtx()
  await reg.executeSlashCommand('upgrade', [], ctx)

  const found = messages.find((m) => m.text && m.text.includes('not currently deployed'))
  expect(found, 'should add a "not currently deployed" message').to.exist
  expect(globalThis.__testConfig.modals, 'no modal should have been created').to.have.length(0)
})

test('/upgrade opens an Upgrade modal when a deployment exists', async () => {
  __resetTestState()
  // Configure db to return an active deployment with a semver version.
  globalThis.__testConfig.db.state = {
    activeDeploymentByAgent: {
      'tui-slash-test': {
        id: 'sha-abc123',
        provider: 'railway',
        deployed_version: '1.5.0',
        deployment_url: 'https://example.com',
      },
    },
  }

  const {ctx, messages} = makeBaseCtx()
  await reg.executeSlashCommand('upgrade', [], ctx)

  const upgradeModal = globalThis.__testConfig.modals.find(
    (m) => typeof m.title === 'string' && m.title.includes('Upgrade'),
  )
  expect(upgradeModal, 'should open an Upgrade modal').to.exist
})

// --------------------------------------------------------------------------
// 6. /connect handler
// --------------------------------------------------------------------------

test('/connect with no args opens a modal when no deployments exist', async () => {
  __resetTestState()
  globalThis.__testConfig.db.state = {listAllDeploymentsForAgent: {}}

  // /connect scans the disk for agents. We don't want the test to
  // accidentally pick up a real user agent directory, so the
  // listAllDeploymentsForAgent empty map will yield zero rows.
  const {ctx, messages} = makeBaseCtx()
  await reg.executeSlashCommand('connect', [], ctx)

  const connectModal = globalThis.__testConfig.modals.find(
    (m) => m.title === 'Connect to Agent',
  )
  expect(connectModal, 'should open a "Connect to Agent" modal').to.exist
})

test('/connect with a SHA arg invokes launchConnect via execFileSync', async () => {
  __resetTestState()
  const {ctx, messages} = makeBaseCtx()
  // The dispatcher catches handler errors and surfaces them as
  // messages, so a `process.exit(0)` call from `launchConnect` ends
  // up as a "Command error" message rather than terminating the
  // test process. We assert on the execFileSync calls instead.
  await reg.executeSlashCommand('connect', ['abc123def'], ctx)

  const calls = globalThis.__testConfig.execFileSyncCalls
  // launchConnect calls `which` to locate the cast binary, then
  // shells out to `cast connect <sha>`.
  const whichCall = calls.find((c) => c.file === 'which')
  expect(whichCall, 'should call `which` to find the cast binary').to.exist
  const connectCall = calls.find(
    (c) => Array.isArray(c.args) && c.args[0] === 'connect' && c.args[1] === 'abc123def',
  )
  expect(connectCall, 'should call `cast connect abc123def`').to.exist
})

