// --------------------------------------------------------------------------
// 10. /deploy handler
// --------------------------------------------------------------------------

test('/deploy with a provider arg shells out via runDeployInTerminal', async () => {
  __resetTestState()
  const {ctx, messages} = makeBaseCtx()
  await reg.executeSlashCommand('deploy', ['railway'], ctx)

  expect(globalThis.__testConfig.deployCalls, 'runDeployInTerminal should be called').to.have.length(1)
  expect(globalThis.__testConfig.deployCalls[0].agentName).to.equal('tui-slash-test')
  expect(globalThis.__testConfig.deployCalls[0].provider).to.equal('railway')
})

