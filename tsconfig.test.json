{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["mocha", "node"],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "tests/**/*.ts",
    "typescript/cast-cli/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "typescript/cast-cli/dist"
  ]
}